<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ServerController.ViewModels"
             xmlns:s="using:ServerController.Services"
             xmlns:m="using:ServerController.Models"
             xmlns:v="using:ServerController.Views"
             x:Class="ServerController.Views.TextDialogView"
             x:DataType="vm:TextDialogViewModel"
             x:Name="Root">
  <StackPanel Spacing="14" Width="780">
    <TextBlock Text="{Binding Title}" Classes="h2" FontSize="19" />
    <Border Classes="console" Height="440">
      <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <SelectableTextBlock Text="{Binding Text}" />
      </ScrollViewer>
    </Border>
    <Button Classes="primary" Content="Kapat" Command="{Binding OkCommand}" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
  </StackPanel>
</UserControl>
