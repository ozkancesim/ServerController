<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ServerController.ViewModels"
             xmlns:s="using:ServerController.Services"
             xmlns:m="using:ServerController.Models"
             xmlns:v="using:ServerController.Views"
             x:Class="ServerController.Views.HistoryView"
             x:DataType="vm:HistoryViewModel"
             x:Name="Root">
  <Border Classes="glass" Padding="12">
    <Grid RowDefinitions="Auto,Auto,*">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding Filter}" Watermark="🔍 İşlem, IP veya sunucu ara…" Width="300" />
          <TextBlock Text="{Binding Summary}" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="📥 Excel'e aktar (CSV)" Command="{Binding ExportCommand}" />
          <Button Classes="danger" Content="Temizle" Command="{Binding ClearCommand}" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="150,170,200,*,40" Margin="10,14,10,6">
        <TextBlock Text="TARİH" Classes="colhead" />
        <TextBlock Grid.Column="1" Text="SUNUCU" Classes="colhead" />
        <TextBlock Grid.Column="2" Text="İŞLEM" Classes="colhead" />
        <TextBlock Grid.Column="3" Text="DETAY" Classes="colhead" />
      </Grid>
      <ListBox Grid.Row="2" Classes="plain" ItemsSource="{Binding Items}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="m:HistoryEntry">
            <Border Classes="row">
              <Grid ColumnDefinitions="150,170,200,*,40">
                <TextBlock Text="{Binding Time, Converter={x:Static v:Conv.Time}}" Classes="muted" />
                <TextBlock Grid.Column="1" Text="{Binding Server}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Action}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <SelectableTextBlock Grid.Column="3" Text="{Binding Detail}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="4" Text="✓" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding Success}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="✗" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding !Success}" HorizontalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
