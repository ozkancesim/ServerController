<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ServerController.ViewModels"
             xmlns:s="using:ServerController.Services"
             xmlns:m="using:ServerController.Models"
             xmlns:v="using:ServerController.Views"
             x:Class="ServerController.Views.OutputDialogView"
             x:DataType="vm:OutputDialogViewModel"
             x:Name="Root">
  <Grid RowDefinitions="Auto,*,Auto" Width="820" Height="560">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" Classes="h2" FontSize="19" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsRunning}" Foreground="{DynamicResource AccentBrush}" />
        <Border Classes="pill" IsVisible="{Binding IsRunning}"><TextBlock Text="{Binding Status}" /></Border>
        <Border Classes="pill success" IsVisible="{Binding Succeeded}"><TextBlock Text="{Binding Status}" /></Border>
        <Border Classes="pill danger" IsVisible="{Binding Failed}"><TextBlock Text="{Binding Status}" /></Border>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Classes="console">
      <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Auto">
        <SelectableTextBlock Text="{Binding Text}" />
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock Text="Uzun süren işlemlerde bu pencereyi açık tutun. Kapatmak için işlemin bitmesini bekleyin."
                 Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding IsRunning}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <Button Content="📋 Kopyala" Command="{Binding CopyCommand}" />
        <Button Classes="danger" Content="⏹ İptal" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
        <Button Classes="primary" Content="Kapat" Command="{Binding CloseDialogCommand}" IsVisible="{Binding !IsRunning}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
